# Obligatoire — mot de passe de connexion à /admin/login
ADMIN_PASSWORD=

# URL publique du site (SEO, JSON-LD, sitemap, Open Graph)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Google Maps Embed API (composant GoogleMapsScript / fiches biens)
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

# Google Places API — avis Google en direct sur la home (fallback sur data/reviews.json si absent)
GOOGLE_PLACES_API_KEY=
GOOGLE_PLACE_ID=

# Resend — envoi des emails (estimation, contact). Optionnel : si absent, les leads sont juste enregistrés sans email.
RESEND_API_KEY=

# Google Analytics (optionnel)
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# OpenAI — analyse IA des documents (mandat/estimation/DPE) dans l'admin biens. Optionnel.
OPENAI_API_KEY=

# Anthropic — assistant conversationnel (widget de chat public). Sans cette clé, le widget affiche une erreur.
ANTHROPIC_API_KEY=
